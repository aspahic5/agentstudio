# Main PostgreSQL
DATABASE_URL=postgres://agent_studio:agent_studio@localhost:5432/agent_studio

# TimescaleDB (messages)
TIMESCALE_URL=postgres://agent_studio:agent_studio@localhost:5433/agent_studio_messages

# Redis
REDIS_URL=redis://localhost:6379

# LiteLLM
LITELLM_BASE_URL=http://localhost:4000

# JWT
JWT_SECRET=change-me-in-production

# Server
PORT=3001
HOST=0.0.0.0

# Node TLS (acceptable for local Docker with self-signed certs)
NODE_TLS_REJECT_UNAUTHORIZED=0
